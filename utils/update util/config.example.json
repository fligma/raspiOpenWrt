{
  "config_version": 2,
  "active_profile": "Default",
  "profiles": [
    {
      "name": "Default",
      "host": "192.168.1.1",
      "port": 22,
      "username": "root",
      "key_file": "",
      "remote_root": "/www_rasconf",
      "source": "",
      "trust_unknown_host": false,
      "remember_password": false,
      "deploy_ignore": [
        "*.bak",
        "assets/private/"
      ],
      "ssh_timeout": 12,
      "post_deploy_commands": [
      ],
      "logging_enabled": true,
      "remote_backup_enabled": false,
      "local_backup_enabled": false,
      "mirror_delete_remote": false,
      "mirror_delete_local": false,
      "backup_directory": "/tmp/rasconf_backups",
      "local_backup_directory": "",
      "keep_last_n_backups": 5,
      "confirm_destructive": true,
      "show_hidden_files": true,
      "auto_connect_sftp": false,
      "auto_connect_ssh": false,
      "use_alt_icon": false,
      "sftp_enabled": true,
      "ssh_enabled": true,
      "addon_dev_enabled": false,
      "ignore_cert_errors": false,
      "reboot_wait_seconds": 30,
      "reboot_retry_interval": 10,
      "reboot_auto_watch": true,
      "default_tab": "Berry",
      "remember_tab_order": true,
      "tab_order": [
        "Berry",
        "SSH",
        "Web Interface",
        "LuCI",
        "Certificates",
        "Web installer"
      ],
      "terminal_font_size": 10,
      "ui_zoom": 100,
      "max_log_lines": 500,
      "log_visible": false,
      "terminal_history_limit": 500,
      "web_port": 8989,
      "web_path": "/cgi-bin/index.py",
      "luci_url": "http://192.168.1.1/",
      "web_tabs": [
        { "name": "Web Interface", "ip": "", "port": 8989, "path": "/cgi-bin/index.py", "scheme": "http" },
        { "name": "LuCI", "ip": "", "port": 80, "path": "/", "scheme": "http" }
      ],
      "addons": {
        "berry": { "enabled": true, "settings": {} },
        "cert_manager": { "enabled": true, "settings": {} },
        "web_installer": { "enabled": true, "settings": {} }
      },
      "quick_commands": [
        { "label": "Show version", "command": "cat /etc/openwrt_release" }
      ]
    }
  ]
}
