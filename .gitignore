src/berry_manager/config/
src/berry_manager/addons/_data/
# The themes folder the program writes beside itself on first boot.
src/berry_manager/themes/

src/berry_manager/addons/_build/
# The bytecode a ``buildtools.py precompile-addons`` run leaves beside an addon's
# own file. A build writes its own into the copy it stages and packs those,
# which are never this folder's business.
*.pyc
src/berry_manager/addons/*.exe
src/berry_manager/addons/*.bin
src/berry_manager/addons/*/*.exe
src/berry_manager/addons/*/*.bin
src/berry_manager/addons/*/_internal/
*.new
*tmp*
*probe_*
*_probe*
# The folder the CI build stages the shipped addons in before packing them
# inside the executable.
src/berry_manager/_addon_bundle/
# And the plain copy of the modules an addon imports, packed the same way.
src/berry_manager/_addon_harness/